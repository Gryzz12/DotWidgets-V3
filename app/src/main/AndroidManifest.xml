<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Para que la hora cambie justo al empezar cada minuto -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Opcional: se concede por ADB para que los botones activen/desactiven directamente -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.calendar" />
        <!-- Para poder abrir la última app de música usada -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DotWidget"
            android:exported="true"
            android:label="@string/w_dot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_dot" />
        </receiver>

        <receiver
            android:name=".ClockWidget"
            android:exported="true"
            android:label="@string/w_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_clock" />
        </receiver>

        <receiver
            android:name=".ProgressWidget"
            android:exported="true"
            android:label="@string/w_progress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_progress" />
        </receiver>

        <receiver
            android:name=".CalendarWidget"
            android:exported="true"
            android:label="@string/w_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_calendar" />
        </receiver>

        <receiver
            android:name=".ClockProgressWidget"
            android:exported="true"
            android:label="@string/w_clockprog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_clockprog" />
        </receiver>

        <receiver
            android:name=".ButtonsWidget"
            android:exported="true"
            android:label="@string/w_buttons">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_buttons" />
        </receiver>

        <receiver
            android:name=".MusicWidget"
            android:exported="true"
            android:label="@string/w_music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_music" />
        </receiver>

        <receiver
            android:name=".MusicSquareWidget"
            android:exported="true"
            android:label="@string/w_musicsq">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_musicsq" />
        </receiver>

        <receiver
            android:name=".CalTempMusicWidget"
            android:exported="true"
            android:label="@string/w_ctm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_ctm" />
        </receiver>

        <receiver
            android:name=".DashWidget"
            android:exported="true"
            android:label="@string/w_dash">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_dash" />
        </receiver>

        <receiver
            android:name=".ClockCalMusicWidget"
            android:exported="true"
            android:label="@string/w_ccm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_ccm" />
        </receiver>

        <receiver
            android:name=".MiniMusicWidget"
            android:exported="true"
            android:label="@string/w_mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_mini" />
        </receiver>

        <receiver
            android:name=".EmptyWidget"
            android:exported="true"
            android:label="@string/w_empty">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/info_empty" />
        </receiver>

        <!-- Lee la música que suena (requiere "Acceso a notificaciones") -->
        <service
            android:name=".MediaListener"
            android:exported="false"
            android:label="Dot Widgets · música"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
